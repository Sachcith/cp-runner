{
  "name": "cp-runner",
  "displayName": "cp-runner",
  "description": "A dedicated competitive programming runner for C++",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
      "commands": [
          {
              "command": "cp-runner.quickRun",
              "title": "CP Runner: Quick Run"
          },
          {
              "command": "cp-runner.fullTest",
              "title": "CP Runner: Full Test"
          },
          {
              "command": "cp-runner.reset",
              "title": "CP Runner: Reset"
          },
          {
              "command": "cp-runner.clearTestcases",
              "title": "CP Runner: Clear Testcases"
          }
      ],
      "keybindings": [
          {
              "command": "cp-runner.quickRun",
              "key": "ctrl+'"
          },
          {
              "command": "cp-runner.fullTest",
              "key": "ctrl+enter"
          },
          {
              "command": "cp-runner.reset",
              "key": "ctrl+shift+backspace"
          },
          {
              "command": "cp-runner.clearTestcases",
              "key": "ctrl+shift+delete"
          }
      ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "npm run package && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.132.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
